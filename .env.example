# Copy this file to .env and fill in real values.
# The app reads these variables at build/request time.

# Base URL of the Strapi instance (no trailing slash)
STRAPI_BASE_PATH=https://your-strapi-instance.strapiapp.com

# API token that grants read access to the Strapi REST API
STRAPI_AUTH_TOKEN=your-strapi-api-token

# Secret token for the POST /api/revalidate endpoint.
# Match this value in the Strapi env var NEXTJS_REVALIDATION_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATION_SECRET=your-revalidation-secret

# URL of the podcast RSS feed
RSS_FEED_URL=https://feeds.example.com/podcast.xml

# YouTube Data API v3 key, used to match episodes to video embeds
YOUTUBE_API_KEY=your-youtube-api-key

# Optional: enables file polling for the dev server (useful in containers/WSL)
# WATCHPACK_POLLING=true